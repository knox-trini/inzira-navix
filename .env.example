# ── AI Provider ──────────────────────────────────────────────────────
# Leave empty to use the built-in knowledge-base fallback.
# Set to an OpenAI-compatible API key to enable external AI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── OAuth Providers (use official OAuth/OIDC APIs) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── USSD Provider ───────────────────────────────────────────────────
# Credentials for your chosen USSD gateway (Africa's Talking, etc.)
USSD_PROVIDER_API_KEY=
USSD_PROVIDER_SECRET=
USSD_PROVIDER_SHORTCODE=

# ── SMS (optional) ──────────────────────────────────────────────────
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SECRET=
